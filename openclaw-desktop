#!/bin/sh
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/openclaw"
mkdir -p "$state_dir"
openclaw gateway --port 18789 >>"$state_dir/gateway.log" 2>&1 &
gateway_pid=$!
trap 'kill "$gateway_pid" 2>/dev/null || true' EXIT INT TERM
attempt=0
while [ "$attempt" -lt 60 ]; do
  if curl -fsS http://127.0.0.1:18789/ >/dev/null 2>&1; then
    xdg-open http://127.0.0.1:18789/
    wait "$gateway_pid"
    exit $?
  fi
  attempt=$((attempt + 1))
  sleep 1
done
exit 1
